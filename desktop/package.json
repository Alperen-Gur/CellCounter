{
  "name": "desktop",
  "private": true,
  "version": "1.0.8",
  "description": "CellCounter native Windows application",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:python": "python3 -m unittest discover -s python -p 'test_*.py'",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:speed": "node scripts/verify-speed-contract.mjs",
    "verify:windows-bundle": "node scripts/verify-windows-bundle.mjs",
    "verify:windows-ci": "node scripts/verify-windows-ci.mjs",
    "verify:windows-docs": "node scripts/verify-windows-docs.mjs",
    "verify:windows-artifacts": "node scripts/verify-windows-artifacts.mjs",
    "verify:windows": "node scripts/verify-windows.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
