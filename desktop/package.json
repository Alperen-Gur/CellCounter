{
  "name": "desktop",
  "private": true,
  "version": "1.3.0",
  "description": "CellCounter native Windows application",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:python": "python3 -m unittest discover -s python -p 'test_*.py'",
    "verify:windows-artifacts": "node scripts/verify-windows-artifacts.mjs",
    "verify:workflow": "node --experimental-strip-types --test tests/workflow.test.ts",
    "verify:review": "node --experimental-strip-types --test scripts/review-session.test.mjs",
    "verify:previews": "node --experimental-strip-types --test src/kernel/viewport/imageRecovery.test.mjs",
    "verify:results": "node --experimental-strip-types src/pages/results/reviewBehavior.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "22.18.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
