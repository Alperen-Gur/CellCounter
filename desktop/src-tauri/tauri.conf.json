{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CellCounter",
  "version": "1.1.0",
  "identifier": "com.alperengur.cellcounter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CellCounter",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/com.alperengur.cellcounter/CellCounter/Images/**",
            "$APPDATA/com.alperengur.cellcounter/CellCounter/Thumbnails/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Alperen Gur",
    "homepage": "https://github.com/Alperen-Gur/CellCounter",
    "copyright": "Copyright © 2026 Alperen Gur",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Medical",
    "shortDescription": "Private, local microscopy cell counting for Windows.",
    "longDescription": "CellCounter analyzes microscopy images locally with three explicitly selected model pipelines and reproducible exports.",
    "useLocalToolsDir": true,
    "externalBin": ["binaries/uv"],
    "resources": {
      "../python": "python"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "9d098d8e-800d-416c-a340-9b6754ea88d0"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "CellCounter",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
